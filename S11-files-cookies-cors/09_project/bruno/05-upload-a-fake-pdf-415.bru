meta {
  name: Upload a fake PDF (415)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/courses/1/materials
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

body:multipart-form {
  title: Fake
  file: @file(files/fake.pdf)
}

tests {
  test("status is 415", function() {
    expect(res.status).to.equal(415);
  });
}
