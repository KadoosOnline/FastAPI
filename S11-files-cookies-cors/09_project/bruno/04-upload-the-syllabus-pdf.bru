meta {
  name: Upload the syllabus (PDF)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/courses/1/materials
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{teacherToken}}
}

body:multipart-form {
  title: Syllabus
  file: @file(files/syllabus.pdf)
}

script:post-response {
  if (res.status < 300) {
    bru.setVar("materialId", res.body.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
    expect(res.body.content_type).to.equal("application/pdf");
  });
}
