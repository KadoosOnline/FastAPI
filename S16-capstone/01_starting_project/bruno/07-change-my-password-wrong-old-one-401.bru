meta {
  name: Change my password - wrong old one (401)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

body:json {
  {
    "old_password": "nope",
    "new_password": "NewPass2026"
  }
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });
}
