meta {
  name: Change my password - weak new one (422)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

body:json {
  {
    "old_password": "Password123",
    "new_password": "weak"
  }
}

tests {
  test("status is 422", function() {
    expect(res.status).to.equal(422);
  });
}
