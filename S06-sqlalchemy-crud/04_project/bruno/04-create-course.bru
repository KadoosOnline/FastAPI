meta {
  name: Create course
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/courses
  body: json
  auth: none
}

headers {
  X-API-Key: {{adminKey}}
}

body:json {
  {
    "title": "Docker",
    "price": 3000000,
    "capacity": 15,
    "instructor_id": 2
  }
}

script:post-response {
  if (res.status < 300) {
    bru.setVar("courseId", res.body.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
}
