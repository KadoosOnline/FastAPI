meta {
  name: Patch price
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/courses/{{courseId}}
  body: json
  auth: none
}

headers {
  X-API-Key: {{adminKey}}
}

body:json {
  {
    "price": 3300000
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.price).to.equal(3300000);
  });
}
