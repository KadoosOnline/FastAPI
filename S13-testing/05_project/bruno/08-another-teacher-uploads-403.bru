meta {
  name: Another teacher uploads (403)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/courses/1/materials
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{teacher2Token}}
}

body:multipart-form {
  title: Mine now
  file: @file(files/syllabus.pdf)
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
}
