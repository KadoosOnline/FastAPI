meta {
  name: Student uploads (403)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/courses/1/materials
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

body:multipart-form {
  title: Homework
  file: @file(files/syllabus.pdf)
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
}
