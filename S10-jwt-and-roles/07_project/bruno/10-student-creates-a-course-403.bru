meta {
  name: Student creates a course (403)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/courses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{studentToken}}
}

body:json {
  {
    "title": "Bruno Course",
    "price": 1500000,
    "capacity": 2,
    "level": "intermediate"
  }
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
}
