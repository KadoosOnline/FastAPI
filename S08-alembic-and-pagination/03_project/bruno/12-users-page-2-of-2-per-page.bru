meta {
  name: Users, page 2 of 2 per page
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/users?page=2&size=2
  body: none
  auth: none
}

headers {
  X-API-Key: {{adminKey}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.page).to.equal(2);
  });
}
