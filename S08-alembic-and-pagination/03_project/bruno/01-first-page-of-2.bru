meta {
  name: First page of 2
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/courses?page=1&size=2
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items.length).to.equal(2);
    expect(res.body.total).to.equal(5);
    expect(res.body.pages).to.equal(3);
  });
}
