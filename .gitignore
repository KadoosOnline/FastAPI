.venv/
venv/

# Databases created by the examples (they are rebuilt on every start)
*.db
*.sqlite3

# Uploaded files (sessions 11 onwards)
uploads/

# Secrets. A committed secret stays in the history for ever.
.env

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
*.sync-conflict-*
