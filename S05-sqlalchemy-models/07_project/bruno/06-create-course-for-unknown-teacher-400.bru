meta {
  name: Create course for unknown teacher (400)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/courses
  body: json
  auth: none
}

headers {
  X-API-Key: {{adminKey}}
}

body:json {
  {
    "title": "Ghost",
    "price": 1,
    "capacity": 1,
    "instructor_id": 999
  }
}

tests {
  test("status is 400", function() {
    expect(res.status).to.equal(400);
  });
}
