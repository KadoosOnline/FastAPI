meta {
  name: Register with common password (422)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "weak@example.com",
    "full_name": "Weak",
    "password": "Password123"
  }
}

tests {
  test("status is 422", function() {
    expect(res.status).to.equal(422);
  });
}
