meta {
  name: Login - email in upper case
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: SARA@EXAMPLE.COM
  password: {{password}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
