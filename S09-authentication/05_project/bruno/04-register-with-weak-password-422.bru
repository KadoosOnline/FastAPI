meta {
  name: Register with weak password (422)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "weak@example.com",
    "full_name": "Weak",
    "password": "12345678"
  }
}

tests {
  test("status is 422", function() {
    expect(res.status).to.equal(422);
  });
}
