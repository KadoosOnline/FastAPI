meta {
  name: Login - disabled user (403)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: reza@example.com
  password: {{password}}
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
}
