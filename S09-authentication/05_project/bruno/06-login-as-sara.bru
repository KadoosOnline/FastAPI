meta {
  name: Login as Sara
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{studentEmail}}
  password: {{password}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user.email).to.equal("sara@example.com");
  });
}
